{
  "name": "dsh-screenwrite",
  "version": "1.5.1",
  "type": "module",
  "description": "A five-element screenplay studio for DeepSeek Harness: a local script library, US Letter pages, PDF and Fountain export, and an agent writing into the same script.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "screenwrite.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md",
    "samples/*.fountain"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "screenplay",
    "screenwriting",
    "script",
    "fountain",
    "pdf"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "thu-huangzc (https://github.com/thu-huangzc)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thu-huangzc/dsh-screenwrite.git"
  },
  "bugs": {
    "url": "https://github.com/thu-huangzc/dsh-screenwrite/issues"
  },
  "homepage": "https://github.com/thu-huangzc/dsh-screenwrite#readme"
}
